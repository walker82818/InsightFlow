{
  "name": "销售基础数据集",
  "description": "各地区销售代表的销售额与订单数，用于验证基础聚合、分组柱状图与 TOP-N。",
  "columns": ["region", "sales_rep", "amount", "orders"],
  "rows": [
    ["华东", "张三", 1200.5, 12],
    ["华东", "李四", 980.0, 9],
    ["华北", "王五", 1500.0, 15],
    ["华北", "赵六", 720.0, 7],
    ["华南", "钱七", 1100.0, 11],
    ["华南", "孙八", 640.0, 6],
    ["西南", "周九", 430.0, 4],
    ["西南", "吴十", 510.0, 5]
