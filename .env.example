# =============================================================================
# InsightFlow — deployment configuration template.
# Copy to `.env` and fill in your values, then `docker compose up -d --build`.
#   cp .env.example .env
# =============================================================================

# --- LLM provider (OpenAI-compatible). Default: DeepSeek. --------------------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
# REQUIRED: your API key.
LLM_API_KEY=
LLM_SMALL_MODEL=deepseek-chat
LLM_LARGE_MODEL=deepseek-reasoner

# --- PostgreSQL (used by docker-compose; defaults match compose) -------------
# The API reads DATABASE_URL. When running under compose you can leave these
# and they are wired via the compose `db` service instead.
# DATABASE_URL=postgresql+asyncpg://insightflow:insightflow@db:5432/insightflow
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=insightflow
POSTGRES_DB=insightflow

# --- Analysis engine (DuckDB) ------------------------------------------------
# DUCKDB_PATH=data/insightflow.duckdb   (persisted via the api data volume)

# --- Object storage (optional: set STORAGE_BACKEND=minio + run minio service)
# STORAGE_BACKEND=local                  # local | minio
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=insightflow

# --- Python code sandbox (optional) ------------------------------------------
# The API runs LLM-generated Python inside a dedicated `insightflow-sandbox`
# container via the Docker socket. To enable, build the sandbox image and add
# the api service to the `sandbox` compose profile:
#   docker build -t insightflow-sandbox ./sandbox
#   docker compose --profile sandbox up -d
# SANDBOX_ALLOW_LOCAL_FALLBACK=false   # keep false in production

# --- Optional Langfuse observability (leave empty to disable) ----------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
