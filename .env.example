# ============ InsightFlow 本地环境配置 ============
# 复制为 .env 后填写本地连接串与密钥

# ---------- 后端 (FastAPI, apps/api) ----------
# PostgreSQL（本地原生安装或本地 Docker 容器均可，连接串格式一致）
DATABASE_URL=postgresql+asyncpg://insightflow:insightflow@localhost:5432/insightflow

# Redis（Phase 6+ 接入，预留）
REDIS_URL=redis://localhost:6379/0

# MinIO（对象存储，本地原生安装或 Docker，预留）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=insightflow

# Python 沙箱（Docker）
SANDBOX_DOCKER_IMAGE=insightflow-sandbox:latest
SANDBOX_TIMEOUT=30

# LLM Provider（provider 抽象，默认国内模型，OpenAI 兼容协议）
# 可选: deepseek / qwen / openai / ...
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
SMALL_MODEL=deepseek-chat
LARGE_MODEL=deepseek-reasoner

# 服务端口
API_HOST=0.0.0.0
API_PORT=8000

# ---------- 前端 (Next.js, apps/web) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
